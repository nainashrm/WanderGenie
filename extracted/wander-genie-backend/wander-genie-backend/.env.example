# ─────────────────────────────────────────────
#  WanderGenie Backend — Environment Variables
# ─────────────────────────────────────────────

# Server
PORT=8000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/wandergenie

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this_too
JWT_REFRESH_EXPIRES_IN=30d

# CORS – comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# AI / Itinerary generation
# Set AI_PROVIDER=openai to call OpenAI, leave blank to use built-in smart generator
AI_PROVIDER=
OPENAI_API_KEY=

# Optional: Weather API (OpenWeatherMap)
WEATHER_API_KEY=
WEATHER_API_BASE=https://api.openweathermap.org/data/2.5
